# 2. Do LPA profiles correlate with Ward cluster assignments?
combined <- lpa_assignments |>
left_join(read_csv("10_participant_profiles/csv/Participant_Profile_Assignments.csv") |>
mutate(participant_id = as.character(participant_id)) |>
select(participant_id, cluster), by = "participant_id")
table(combined$lpa_class, combined$cluster)
lpa_input |>
mutate(lpa_class = lpa_assignments$lpa_class) |>
group_by(lpa_class) |>
summarise(across(all_of(factor_cols), mean))
factor_lookup |> filter(instrument == "AIReflection") |> select(factor, proposed_name)
factor_lookup |> filter(instrument == "IMI") |> select(factor, proposed_name)
lpa_input |>
mutate(lpa_class = lpa_assignments$lpa_class) |>
left_join(read_csv("09_art_vs_all_factors_items/csv/ART_Scored.csv") |>
mutate(participant_id = as.character(participant_id)) |>
select(participant_id, art_net_real_minus_fake),
by = "participant_id") |>
group_by(lpa_class) |>
summarise(art_mean = mean(art_net_real_minus_fake, na.rm=TRUE),
art_sd = sd(art_net_real_minus_fake, na.rm=TRUE),
n = n())
kruskal.test(art_net_real_minus_fake ~ lpa_class, data = lpa_input |>
mutate(lpa_class = lpa_assignments$lpa_class) |>
left_join(read_csv("09_art_vs_all_factors_items/csv/ART_Scored.csv") |>
mutate(participant_id = as.character(participant_id)) |>
select(participant_id, art_net_real_minus_fake), by = "participant_id"))
pairwise.wilcox.test(
x = (lpa_input |>
mutate(lpa_class = lpa_assignments$lpa_class) |>
left_join(read_csv("09_art_vs_all_factors_items/csv/ART_Scored.csv") |>
mutate(participant_id = as.character(participant_id)) |>
select(participant_id, art_net_real_minus_fake), by="participant_id"))$art_net_real_minus_fake,
g = lpa_assignments$lpa_class,
p.adjust.method = "BH"
)
